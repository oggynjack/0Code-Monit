# ==========================================
# 0Code-Monit Configuration Environment File
# ==========================================

# Server Host & Port (Render / Cloud platforms dynamically inject PORT)
PORT=3000
CODE_MONIT_PORT=3000
HOST=0.0.0.0

# Node Environment ('production' or 'development')
NODE_ENV=production

# Data Storage Directory (default: ./data)
# On Render.com, set this to your persistent disk mount path, e.g. /app/data
DATA_DIR=./data

# Google OAuth Configuration (Optional - for public user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Security & Secrets
# JWT Secret is automatically generated if not supplied
# JWT_SECRET=your-random-jwt-secret-key

# SSL Configuration (Optional if not behind reverse proxy/Cloudflare)
# SSL_KEY=
# SSL_CERT=
# SSL_KEY_PASSPHRASE=

# WebSocket Origin Check ('cors-like' or 'bypass')
CODE_MONIT_WS_ORIGIN_CHECK=cors-like
